# Downloaded source data + generated outputs
data/*
*.csv

# ...but DO commit the small illustrative result samples
!data_samples/
!data_samples/*.csv

# ...and DO commit the static monthly macro series (fixed historical record, pulled once).
# Note: ignore data/* (contents) not data/ (dir) so this un-ignore can take effect.
!data/macro_monthly.csv

# ...and the generated feature-importance table (small, handy to diff across runs)
!feature_importance.csv

# ...and DO commit the FROZEN historical poll snapshots (Internet Archive captures of 538,
# which never change). Committing them removes the fragile/rate-limited live Wayback dependency.
!data/senate_historical.csv
!data/house_historical.csv
!data/governor_historical.csv
!data/generic_ballot_historical.csv

# ...and the NYT "current" poll files — the 2024 cycle is OVER, so these are frozen history now
# too. If re-fetched, the NYT endpoint would serve 2026-cycle polls (or nothing) and silently
# change the training data. Committed = the training set is reproducible offline.
!data/senate_current.csv
!data/house_current.csv
!data/governor_current.csv

# ...and the results + metadata files (538's repos are unmaintained; past results never change;
# the repos could vanish). With these, ALL model inputs are committed — no network on any run.
!data/res_senate.csv
!data/res_house.csv
!data/res_governor.csv
!data/races.csv
!data/lean_states.csv
!data/lean_districts.csv
!data/raw_polls_538.csv
!data/generic_ballot_hist_538.csv
!data/approval_monthly.csv
!data/generic_ballot_monthly.csv
!data/fec_summary.csv
!data/fec_detail.csv
!data/governor_finance.csv
!data/district_pvi_current.csv
!data/redistricted_2026.csv
!data/candidate_party_overrides.csv
!data/dropped_out_2026.csv

# ...and the trained production model artifacts (predict.py / predict_margin.py load these)
!data/model_xgb.json
!data/model_features.json
!data/margin_model_xgb.json
!data/margin_model_features.json

# ...and the margin model's importance table (small, diffable, like feature_importance.csv)
!margin_feature_importance.csv

# transient scraper run-logs (progress traces via `tee`; not source data — the CSVs are)
ballotpedia_scrape*.txt
backfill_*_scrape_log.txt
backfill_*_log.txt

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/
.env

# PRIMARY model static inputs + artifacts (2026-07-15): Wikipedia-scraped training polls
# (pages get edited — a re-scrape is NOT reproducible), hand-entered dates, built dataset,
# trained artifact. Same static-data principle as above.
!data/primary_polls_wikipedia.csv
!data/primary_polls_long.csv
!data/primary_dates_hist.csv
!data/primary_model_xgb.json
!data/primary_model_features.json

# Senate/Governor primary RESULTS (fetch_primary_results_2026.py --hist) - was never
# actually un-ignored despite being static-data-principle scraped output; found + fixed
# 2026-07-22 while building the House equivalent below (it was living local-only).
!data/primary_results_hist.csv

# House primary RESULTS, 1998-2024 (fetch_house_primary_results_hist.py, 2026-07-22):
# Wikipedia per-state "House elections in X" summary pages - not reproducible on re-scrape
# (pages get edited), fact-checked (see that script's docstring), committed once.
!data/house_primary_results_hist.csv

# committed 2026-07-16 for the model-refresh GitHub Action: CI clones this repo fresh and
# predict*.py needs the historical polls (house effects + bias priors) without running
# build_dataset.ipynb. 14MB, regenerable, but committing = static-data principle anyway.
!polls_long_with_results.csv
!data/candidate_bios.csv

# per-office bio SOURCE files (2026-07-24 save-discipline change: each office scrapes to
# its own file, combine_candidate_bios.py builds the merged candidate_bios.csv above -
# commit the sources too or the layout only exists on one machine)
!data/candidate_bios_senate.csv
!data/candidate_bios_governor.csv
!data/candidate_bios_house.csv
# Ballotpedia gap-filler (person-level; combine_candidate_bios.py expands + merges it,
# Wikipedia preferred) + the uncovered-candidates list it targets
!data/candidate_bios_ballotpedia.csv
!data/uncovered_candidates.csv
# the still-uncovered office_level target roster (regenerated after each backfill stage;
# drives the Ballotpedia/manual passes) — small, diffable, reference-able
!data/office_level_backfill_targets.csv
# Stage-3 HAND-CODED office histories (offices_json tenure dates + source_note) for winners
# no scraper could reach - static, reviewable, the authoritative manual source for the builder
!data/candidate_bios_manual.csv

# local archive of pre-change data copies (archive-don't-delete rule is a LOCAL backup
# discipline — these are point-in-time snapshots, not repo content; never committed, same
# as the earlier archive/candidate_bios_<timestamp> files documented in METHODOLOGY)
archive/
